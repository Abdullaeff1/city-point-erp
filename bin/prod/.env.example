DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=erp.citypoint.az,portal.citypoint.az,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.citypoint.az,https://erp.citypoint.az
# Runtime app role (see docs/security/postgres-roles.md). Migrate with cp_migrator separately.
POSTGRES_DB=citypoint
POSTGRES_USER=cp_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
SEED_DEMO=0
DEFAULT_FROM_EMAIL=noreply@citypoint.az
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
