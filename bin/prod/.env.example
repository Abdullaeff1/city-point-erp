CP_ENV=production
CP_OFFLINE=1
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=erp.citypoint.local,portal.citypoint.local,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://portal.citypoint.local,http://erp.citypoint.local
# Runtime app role (see docs/security/postgres-roles.md). Migrate with cp_migrator separately.
POSTGRES_DB=citypoint
POSTGRES_USER=cp_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
SEED_DEMO=0
DEFAULT_FROM_EMAIL=noreply@citypoint.local
# Air-gapped default: file outbox (or set internal LAN SMTP and override EMAIL_BACKEND)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.citypoint.local
EMAIL_FILE_PATH=/app/var/mail_outbox
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=1
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
# If internal TLS later: SESSION_COOKIE_SECURE=1 and https:// origins
