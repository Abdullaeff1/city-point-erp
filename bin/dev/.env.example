# Dev local — copy to bin/dev/.env (do NOT commit .env)
# Same LAN as City Point AxTrax required for live events.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

POSTGRES_DB=citypoint
POSTGRES_USER=citypoint
POSTGRES_PASSWORD=citypoint
POSTGRES_HOST=db
POSTGRES_PORT=5432

SEED_DEMO=1

# AxTrax (City Point LAN — same switch/VLAN as working teammate PC)
AXTRAX_POLL_ON_START=1
AXTRAX_BOOTSTRAP_ON_START=1
AXTRAX_POLL_INTERVAL=15
# People/companies/cards refresh from AxTrax (seconds). 0 = events only.
AXTRAX_PEOPLE_SYNC_INTERVAL=300
TURNSTILE_MSSQL_HOST=172.31.104.10
TURNSTILE_MSSQL_PORT=1433
TURNSTILE_MSSQL_DATABASE=AxTrax1
TURNSTILE_MSSQL_USER=ReadOnlyerp
# Ask teammate / IT — never commit real password
# If password has # ' " etc, wrap in double quotes: TURNSTILE_MSSQL_PASSWORD="p@ss#word"
TURNSTILE_MSSQL_PASSWORD=

# Zoho Mail → portal announcements (all residents → building; A.8)
# Default off until IMAP mailbox + all-residents address are ready
ZOHO_POLL_ON_START=0
ZOHO_POLL_INTERVAL=60
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USER=
ZOHO_IMAP_PASSWORD=
ZOHO_IMAP_MAILBOX=INBOX
ZOHO_ALL_RESIDENTS_ADDRESS=all.residents@example.com
# Optional comma-separated From allowlist (empty = any sender)
ZOHO_SENDER_ALLOWLIST=

# Ticket SLA escalation poller (risk/breach → in-app + email outbox)
TICKET_SLA_POLL_ON_START=0
TICKET_SLA_POLL_INTERVAL=120

# CRM lead idle / offer follow-up reminders
CRM_REMINDER_POLL_ON_START=0
CRM_REMINDER_POLL_INTERVAL=300
CRM_DEFAULT_RENT_RATE_PER_M2=33.00
CRM_VAT_RATE=18.00

# Outlook → portal announcements (LEGACY — replaced by Zoho; see docs/integrations/outlook-announcements.md)
OUTLOOK_POLL_ON_START=0
OUTLOOK_POLL_INTERVAL=60
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
