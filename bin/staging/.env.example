# Staging environment (copy to bin/staging/.env — never commit secrets)
CP_ENV=staging
DJANGO_SECRET_KEY=change-me-staging-long-random
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=staging.citypoint.az,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.citypoint.az
POSTGRES_DB=citypoint_staging
POSTGRES_USER=cp_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
SEED_DEMO=0
DEFAULT_FROM_EMAIL=noreply-staging@citypoint.az
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
SESSION_COOKIE_AGE=28800
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
